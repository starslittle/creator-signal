{
  "manifest_version": 3,
  "name": "知创 · 创作者信号",
  "version": "0.2.0",
  "description": "分析 B站 UP 主的品牌合作公开证据等级、合作状态和变现渠道，逐条展示原文依据。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "分析这位 UP 主"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "打开创作者信号分析"
    }
  },
  "key": ""
}
